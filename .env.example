# ── VWorld 인증키 ──
# https://www.vworld.kr 에서 발급. 등록 도메인: localhost / 127.0.0.1 / pipe-line.pages.dev
# 키가 없으면 placeholder 그대로 두면 됨 → 앱이 mock 모드로 동작한다.
VITE_VWORLD_KEY=YOUR_VWORLD_KEY

# JSONP 호출 시 함께 보내는 등록 도메인 (로컬은 127.0.0.1, 운영은 pages.dev 도메인)
VITE_VWORLD_DOMAIN=127.0.0.1

# API 호출 경로 전략: "jsonp" (직접호출, 기본) | "proxy" (Cloudflare/Vite 프록시 경유)
VITE_API_MODE=jsonp

# ── 공공데이터포털(data.go.kr) 인증키 ──
# 건축HUB 건축물대장(getBrTitleInfo) 조회용. 주소 검색 시 계량기 자동 입력에 사용.
# 미설정 시 계량기 자동 입력만 비활성(검색·마커는 정상 동작).
VITE_DATAGO_KEY=YOUR_DATAGO_KEY

# ── 도로 데이터(도로명주소 도로구간) 공개 URL ──
# tools/extract-roads.sh 로 추출 → R2 업로드 후 그 공개 URL. 예: https://pub-xxxx.r2.dev/roads
# 미설정 시 기본 버킷(road-data)을 사용하므로 보통 비워두면 된다.
VITE_ROADS_URL=
