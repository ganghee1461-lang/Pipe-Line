# ── VWorld 인증키 ──
# https://www.vworld.kr 에서 발급. 등록 도메인: localhost / 127.0.0.1 / pipe-line.pages.dev
# 키가 없으면 placeholder 그대로 두면 됨 → 앱이 mock 모드로 동작한다.
VITE_VWORLD_KEY=YOUR_VWORLD_KEY

# JSONP 호출 시 함께 보내는 등록 도메인 (로컬은 127.0.0.1, 운영은 pages.dev 도메인)
VITE_VWORLD_DOMAIN=127.0.0.1

# API 호출 경로 전략: "jsonp" (직접호출, 기본) | "proxy" (Cloudflare/Vite 프록시 경유)
VITE_API_MODE=jsonp

# ── 생활안전지도 건설공사현황 인증키 ──
# https://safemap.go.kr 에서 발급. 미설정 시 '건설공사현황' 토글은 데모(mock) 데이터로 동작.
# 반드시 VITE_ 접두사여야 빌드에 포함됨(변수명 'Erection' 같은 건 인식 안 됨).
VITE_SAFEMAP_KEY=YOUR_SAFEMAP_KEY
